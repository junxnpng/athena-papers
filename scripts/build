#!/usr/bin/env python3
"""data/papers.json → site/catalog.fragment.html (Hugo 페이지 안에 들어가는 조각) + site/index.html (미리보기용 완전한 문서). 결정론적.
노트(notes/*.md)가 있는 논문에는 Note → 링크가 붙는다. 색은 PaperMod 변수에 기대므로 다크 모드가 따라온다.

  scripts/build            생성
  scripts/build --check    생성 결과가 site/index.html 과 같은지만 검사 (I3: 사이트는 파생물, 손으로 고치지 않는다)
"""
from __future__ import annotations

import argparse
import re
import sys
from collections import OrderedDict
from html import escape as E
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import papers as P  # noqa: E402

SITE = P.ROOT / "site" / "index.html"
TITLE = "Papers"
HUB_EN = {"concept": "Concepts & Surveys", "model": "Models", "runtime": "Serving Runtime", "kv-cache": "KV Cache",
          "distributed": "Distributed Serving", "storage": "Storage", "hardware-path": "Hardware Path",
          "session-reuse": "Session KV Reuse", "workload": "Workloads", "sim-method": "Simulation & Traces"}
KIND_EN = {"전문 번역": "full translation", "핵심 발췌 번역": "key excerpts", "정독·분석": "close reading", "해설": "explainer", "기타": "note"}

CSS = """
