#!/usr/bin/env python3
"""data/papers.json → site/index.html (단일 파일, 외부 자원 없음). 결정론적 — 같은 데이터면 같은 HTML.

  scripts/build            생성
  scripts/build --check    생성 결과가 site/index.html 과 같은지만 검사 (I3: 사이트는 파생물, 손으로 고치지 않는다)
"""
from __future__ import annotations

import argparse
import sys
from collections import OrderedDict
from html import escape as E
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import papers as P  # noqa: E402

SITE = P.ROOT / "site" / "index.html"
TITLE = "Papers"
HUB_EN = {"concept": "Concepts & Surveys", "model": "Models", "runtime": "Serving Runtime", "kv-cache": "KV Cache",
          "distributed": "Distributed Serving", "storage": "Storage", "hardware-path": "Hardware Path",
          "session-reuse": "Session KV Reuse", "workload": "Workloads", "sim-method": "Simulation & Traces"}
KIND_EN = {"전문 번역": "full translation", "핵심 발췌 번역": "key excerpts", "정독·분석": "close reading", "해설": "explainer", "기타": "note"}

CSS = """
:root{--bg:#f7f7f5;--fg:#1b1b1b;--mut:#6b6b66;--card:#fff;--line:#e3e2dd;--acc:#1f5fbf;--chip:#eef0f4;--chipfg:#333;--badge:#ffe9b3;--badgefg:#6b4b00;--hl:#fff7cf}
@media (prefers-color-scheme:dark){:root{--bg:#141517;--fg:#e8e6e1;--mut:#9a9a94;--card:#1d1f23;--line:#2c2f35;--acc:#7fb0ff;--chip:#272a31;--chipfg:#d6d6d0;--badge:#4a3a10;--badgefg:#ffd980;--hl:#3a3410}}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.6 -apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Noto Sans KR","Segoe UI",Roboto,sans-serif}
a{color:var(--acc)}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px 60px}
header.top{padding:40px 0 16px}
header.top h1{margin:0 0 6px;font-size:28px;letter-spacing:-.01em}
header.top p{margin:0;color:var(--mut)}
.tally{margin-top:10px;font-size:14px;color:var(--mut)}.tally b{color:var(--fg)}
.bar{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding:10px 0;margin-bottom:24px}
.bar .row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.bar input[type=search]{flex:1 1 260px;min-width:200px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg);font-size:15px}
.bar select{padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--fg);font-size:14px}
.hubs{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.hubs button{border:1px solid var(--line);background:var(--card);color:var(--fg);padding:4px 10px;border-radius:999px;font-size:13px;cursor:pointer}
.hubs button.on{background:var(--acc);border-color:var(--acc);color:#fff}
.hubs button small{opacity:.7;margin-left:4px}
.sec{margin:34px 0 10px}
.sec h2{margin:0;font-size:22px;display:flex;align-items:baseline;gap:10px}
.sec h2 .n{font-size:14px;color:var(--mut);font-weight:normal}
.sec p.blurb{margin:6px 0 0;color:var(--mut);max-width:80ch}
h3.sub{margin:22px 0 8px;font-size:15px;color:var(--mut);font-weight:600;text-transform:none}
h3.sub .n{font-weight:normal;margin-left:6px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:14px}
