footer p{margin:4px 0}
/* 폰: 막대가 칩 여섯 줄로 커져 내용을 덮는다(2026-09-06 실기기). 고정을 풀고 같이 흘러가게 */
@media (max-width:640px){
  .bar{position:static;padding:8px 0;margin-bottom:16px}
  .bar .row{gap:6px}
  .hubs{gap:5px}
  .hubs button{padding:3px 9px;font-size:12px}
}
"""

JS = """
(function(){
  var q=document.getElementById('q'),kind=document.getElementById('kind'),year=document.getElementById('year');
  var hubBtns=[].slice.call(document.querySelectorAll('.hubs button'));
  var cards=[].slice.call(document.querySelectorAll('.card'));
  var hub='';
  function norm(s){return (s||'').toLowerCase();}
  function apply(){
    var text=norm(q.value).trim(),k=kind.value,y=year.value,shown=0;
    cards.forEach(function(c){
      var ok=(!hub||c.dataset.hub===hub)&&(!k||c.dataset.kind===k)&&(!y||c.dataset.year===y)&&(!text||c.dataset.q.indexOf(text)>=0);
      c.hidden=!ok; if(ok) shown++;
    });
    document.querySelectorAll('.sec').forEach(function(sec){
      var n=0; sec.querySelectorAll('.card').forEach(function(c){ if(!c.hidden) n++; });
      sec.hidden=n===0; var lbl=sec.querySelector('h2 .n'); if(lbl) lbl.textContent=n;
      sec.querySelectorAll('.subblock').forEach(function(b){
        var m=0; b.querySelectorAll('.card').forEach(function(c){ if(!c.hidden) m++; });
        b.hidden=m===0; var l=b.querySelector('h3 .n'); if(l) l.textContent=m;
      });
    });
    document.getElementById('shown').textContent=shown;
    document.getElementById('empty').hidden=shown!==0;
    hubBtns.forEach(function(b){ b.classList.toggle('on',(b.dataset.hub||'')===hub); });
  }
  hubBtns.forEach(function(b){ b.addEventListener('click',function(){ hub=(hub===b.dataset.hub)?'':(b.dataset.hub||''); apply(); }); });
  q.addEventListener('input',apply); kind.addEventListener('change',apply); year.addEventListener('change',apply);
  document.getElementById('reset').addEventListener('click',function(){ q.value=''; kind.value=''; year.value=''; hub=''; apply(); });
  cards.forEach(function(c){ var p=c.querySelector('p.sum'); if(p) p.addEventListener('click',function(){ p.classList.toggle('open'); }); });
  apply();
})();
"""


def card(p: dict) -> str:
    q = " ".join([p["title_ko"], p["title_en"], p["summary"], p["venue"], p["authors"], p["affil"]] + p["chips"]).lower()
    out = ['<article class="card" data-hub="%s" data-kind="%s" data-year="%s" data-q="%s">' % (
        E(p["hub"]), E(p["kind"]), E(p["year"]), E(q, quote=True))]
    if p["badge"]:
        out.append('<span class="badge">%s</span>' % E(p["badge"]))
    out.append("<h4>%s</h4>" % E(p["title_ko"]))
    if p["title_en"]:
        out.append('<div class="en">%s</div>' % E(p["title_en"]))
    meta = []
    if p["venue"]:
        meta.append('<span class="chip v">%s</span>' % E(p["venue"]))
    meta.append('<span class="chip">%s</span>' % E(KIND_EN.get(p["kind"], p["kind"])))
    if p.get("license"):
        ok = P.embed_allowed(p["license"])
        meta.append('<span class="chip lic %s" title="%s">%s</span>' % (
            "ok" if ok else "no", "Figures may be reproduced with credit" if ok else "No reuse permission — redraw figures", E(p["license"])))
    for c in p["chips"]:
        if c != p["venue"] and c != p["year"]:
            meta.append('<span class="chip">%s</span>' % E(c))
    out.append('<div class="meta">%s</div>' % "".join(meta))
    if p["summary"]:
        out.append('<p class="sum" title="Click to expand">%s</p>' % E(p["summary"]))
    if p["needs_rewrite"]:
        out.append('<div class="todo">summary pending</div>')
    if p["abstract"]:
        out.append("<details><summary>Abstract</summary><p>%s</p></details>" % E(p["abstract"]))
    if p["authors"]:
        who = E(p["authors"]) + (" · " + E(p["affil"]) if p["affil"] else "")
        out.append('<div class="who">%s</div>' % who)
    link = ('<a href="%s" target="_blank" rel="noopener">Source ↗</a>' % E(p["source_url"], quote=True)) if p["source_url"] else '<span class="todo">source link pending</span>'
    out.append('<div class="foot"><span class="who">%s</span>%s</div>' % (E(p["subcategory"]), link))
    out.append("</article>")
    return "\n".join(out)


def render(data: dict) -> str:
    papers = data["papers"]
    hubs = data.get("hubs", [])
    hub_name = {h["id"]: HUB_EN.get(h["id"], h["name"]) for h in hubs}
    hub_blurb = {h["id"]: h["blurb"] for h in hubs}
    groups = OrderedDict()
    for p in papers:
        groups.setdefault(p["hub"], OrderedDict()).setdefault(p["subcategory"], []).append(p)
    years = sorted({p["year"] for p in papers if p["year"]}, reverse=True)
    kinds = [k for k in P.KINDS if any(p["kind"] == k for p in papers)]

    h = ['<!doctype html>', '<html lang="ko">', '<head>', '<meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width, initial-scale=1">',
         "<title>%s</title>" % E(TITLE), "<style>%s</style>" % CSS, "</head><body>", '<div class="wrap">',
         '<header class="top"><h1>%s</h1>' % E(TITLE),
         "<p>Reading notes on LLM inference and serving. Summaries in Korean, links to the originals.</p>",
         '<div class="tally"><b>%d</b> papers · <b>%d</b> areas · showing <b id="shown">%d</b></div></header>' % (
             len(papers), len(groups), len(papers)),
         '<div class="bar"><div class="row">',
         '<input id="q" type="search" placeholder="Search title, summary, authors, keywords" aria-label="Search">',
         '<select id="kind" aria-label="Depth"><option value="">All depths</option>%s</select>' % "".join(
             '<option value="%s">%s</option>' % (E(k), E(KIND_EN.get(k, k))) for k in kinds),
         '<select id="year" aria-label="Year"><option value="">All years</option>%s</select>' % "".join(
             '<option value="%s">%s</option>' % (E(y), E(y)) for y in years),
         '<button id="reset" type="button">Reset</button></div>',
         '<div class="hubs"><button type="button" data-hub="">All</button>%s</div></div>' % "".join(
             '<button type="button" data-hub="%s">%s<small>%d</small></button>' % (E(hid), E(hub_name.get(hid, hid)), sum(len(v) for v in subs.values()))
             for hid, subs in groups.items())]
    for hid, subs in groups.items():
        n = sum(len(v) for v in subs.values())
        h.append('<section class="sec" id="%s"><h2>%s <span class="n">%d</span></h2>' % (E(hid), E(hub_name.get(hid, hid)), n))
        if hub_blurb.get(hid):
            h.append('<p class="blurb">%s</p>' % E(hub_blurb[hid]))
        for sub, ps in subs.items():
            h.append('<div class="subblock">')
            if sub:
                h.append('<h3 class="sub">%s<span class="n">%d</span></h3>' % (E(sub), len(ps)))
            h.append('<div class="grid">%s</div></div>' % "\n".join(card(p) for p in ps))
        h.append("</section>")
    h.append('<div id="empty" class="empty" hidden>No papers match.</div>')
    h.append("<footer><p>Each card is a Korean summary of a paper's contribution. Copyrighted text and figures are not reproduced; follow the link to the original.</p>"
             "<p>These are personal reading notes and may contain errors. Refer to the original for the facts.</p></footer>")
    h.append("</div><script>%s</script></body></html>" % JS)
    return "\n".join(h) + "\n"


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--data", default=str(P.DATA))
    ap.add_argument("--out", default=str(SITE))
    a = ap.parse_args(argv)
    out = Path(a.out)
    html_text = render(P.load(Path(a.data)))
    if a.check:
        cur = out.read_text(encoding="utf-8") if out.exists() else ""
        if cur != html_text:
            print("build --check: %s 가 최신이 아니다 — scripts/build 를 돌려라" % out)
            return 1
        print("build --check: ok")
        return 0
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(html_text, encoding="utf-8")
    print("build: %s (%d bytes)" % (out, len(html_text.encode("utf-8"))))
    return 0


if __name__ == "__main__":
    sys.exit(main())
