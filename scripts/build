.badge{display:inline-block;background:var(--badge);color:var(--badgefg);padding:1px 8px;border-radius:6px;font-size:12px;margin-bottom:2px;align-self:flex-start}
.card h4,.card .en,.card p.sum,.card details p,.sec p.blurb{word-break:keep-all;overflow-wrap:break-word} /* 한국어는 단어 단위로 접는다 (실기기 확인) */
.card p.sum{margin:0;font-size:14px;display:-webkit-box;-webkit-line-clamp:6;-webkit-box-orient:vertical;overflow:hidden;cursor:pointer}
